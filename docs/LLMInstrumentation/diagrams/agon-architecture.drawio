middle;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="220" height="60" as="geometry"/></mxCell><mxCell id="8e71966eae" value="start (only entry point)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="46ee46ff5e" target="63822eee8e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="abf6fdba30" value="esc — debate keeps&lt;br&gt;running in background" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="63822eee8e" target="51e94f1e74"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="470"/><mxPoint x="540" y="570"/></Array></mxGeometry></mxCell><mxCell id="4c46f78fb3" value="archive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="51e94f1e74" target="40736af830"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="570"/><mxPoint x="185" y="460"/></Array></mxGeometry></mxCell><mxCell id="d7cf6ff923" value="enter ● live&lt;br&gt;(resume stream)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="40736af830" target="63822eee8e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="380"/><mxPoint x="500" y="165"/></Array></mxGeometry></mxCell><mxCell id="756fa6df16" value="enter ◾" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="40736af830" target="0a143404f6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="9d7ed8bde7" value="esc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="0a143404f6" target="40736af830"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="400"/></Array></mxGeometry></mxCell><mxCell id="5a0d5405c3" value="new — blocked while&lt;br&gt;one debate live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;startArrow=none;endArrow=block;" edge="1" parent="1" source="51e94f1e74" target="46ee46ff5e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="570"/><mxPoint x="150" y="260"/></Array></mxGeometry></mxCell><mxCell id="962008e314" value="Keys in session view: j/k scroll · a abort (confirm, live only) · esc back out · ctrl+c quit app. Live debate runs on its own goroutine; the archive JSON is written once, atomically, when the verdict completes — regardless of which screen is focused. After verdict, esc returns to the archive list." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="e0ed07f6d5" name="5 - Archive Data Model"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="42a9853811" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="420" height="560" as="geometry"/></mxCell><mxCell id="39cc0142a5" value="debates/&lt;session_id&gt;.json&lt;br&gt;{&lt;br&gt;  &quot;session_id&quot;: &quot;2026-08-12-…&quot;,&lt;br&gt;  &quot;title&quot;: &quot;…&quot;, &quot;topic&quot;: &quot;…&quot;,&lt;br&gt;  &quot;mode&quot;: &quot;proposition | versus&quot;,&lt;br&gt;  &quot;tone&quot;: &quot;formal | informal | …&quot;,&lt;br&gt;  &quot;rounds&quot;: 3,&lt;br&gt;  &quot;sides&quot;: [ {&quot;id&quot;,&quot;label&quot;,&quot;stance&quot;} ],&lt;br&gt;  &quot;model&quot;: &quot;unsloth/Qwen3-…&quot;,&lt;br&gt;  &quot;repo&quot;: &quot;detected from context&lt;br&gt;            text, or absent&quot;,&lt;br&gt;  &quot;created_at&quot;: &quot;…&quot;,&lt;br&gt;  &quot;messages&quot;: [&lt;br&gt;    { &quot;role&quot;: &quot;advocate&quot;, &quot;round&quot;: 1,&lt;br&gt;      &quot;content&quot;: &quot;…markdown…&quot;,&lt;br&gt;      &quot;tool_calls&quot;: [&lt;br&gt;        {&quot;name&quot;,&quot;args&quot;,&quot;result_summary&quot;}&lt;br&gt;      ],&lt;br&gt;      &quot;ts&quot;: 1234.5 }&lt;br&gt;  ],&lt;br&gt;  &quot;verdict&quot;: &quot;…markdown…&quot;,&lt;br&gt;  &quot;aborted&quot;: {}&lt;br&gt;}" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="380" height="540" as="geometry"/></mxCell><mxCell id="e05924f589" value="Written exactly once (tmp + rename) when the verdict completes — full transcript or none at all; killed/aborted debates leave no file. Archive list screen = readdir + one unmarshal per file." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="660" width="520" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>